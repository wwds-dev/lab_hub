# Python
__pycache__/
*.pyc
.pytest_cache/

# Environments
venv/
.venv/
env/

# Local settings. The app's real config lives in
# ~/Library/Application Support/Lab Hub/, not here — this only catches a stray
# copy left in the working tree.
config.json
.env
*.key

# Local tooling
.claude/settings.local.json
.DS_Store

# Run artifacts
*.log
*.csv
*.db
*.zip
output/

# PyInstaller output. The .spec is regenerated by build_app.sh on every run,
# so the script is the source of truth, not a checked-in spec file.
build/
dist/
dist.noindex/
*.spec

# iconutil's input folder — a pure intermediate. icon.icns is the committed
# asset; make_icon.py regenerates both.
assets/icon.iconset/
